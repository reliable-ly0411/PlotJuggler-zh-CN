+TEST_F(CsvRuntimeLanguage, InvalidTimestampRetainsRawInputAndCanonicalWarning) {
+  const std::string raw = "坏%1\"Rows Skipped\"Invalid timestamp";
+  const std::string csv = "time,value\n1,10\n" + csvCell(raw) + ",20\n";
+  ASSERT_TRUE(import(csv, {{"time_mode", "column"}, {"time_column_index", 0}}));
+  checkSkipped(
+      expected("Line 3: Invalid timestamp: ", "行 3: 无效的时间戳：", "行 3: 無效的時間戳記：") + "\"" + raw + "\"\n");
+  EXPECT_EQ(data_.rows, (std::vector<std::vector<double>>{{10}}));
+  PJ::CSV::CsvParseConfig config;
+  config.time_column_index = 0;
+  const auto parsed = PJ::CSV::ParseCsvData(csv, config);
+  ASSERT_EQ(parsed.warnings.size(), 1U);
+  EXPECT_EQ(parsed.warnings[0].type, PJ::CSV::CsvParseWarning::INVALID_TIMESTAMP);
+  EXPECT_EQ(parsed.warnings[0].line_number, 3);
+  EXPECT_EQ(parsed.warnings[0].detail, "Invalid timestamp: \"" + raw + "\"");
+  EXPECT_EQ(parsed.lines_processed, 1);
+  EXPECT_EQ(parsed.lines_skipped, 1);
+}
