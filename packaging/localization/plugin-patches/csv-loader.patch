+TEST_F(CsvRuntimeLanguage, FirstDisplaySelectionIsImmutableAcrossImports) {
+  ASSERT_TRUE(import("time,value\n0,10\n"));
+  const auto original = data_.progress;
+  const auto [present, saved] = environmentLanguage();
+#ifdef _WIN32
+  (void)present;  // The CRT represents an empty value by removing the variable.
+#endif
+#ifdef _WIN32
+  ASSERT_EQ(_putenv_s("PLOTJUGGLER_UI_LANGUAGE", saved == "zh_TW" ? "en_US" : "zh_TW"), 0);
+#else
+  ASSERT_EQ(setenv("PLOTJUGGLER_UI_LANGUAGE", saved == "zh_TW" ? "en_US" : "zh_TW", 1), 0);
+#endif
+  data_ = {};
+  const auto result = import("time,value\n0,10\n");
+#ifdef _WIN32
+  EXPECT_EQ(_putenv_s("PLOTJUGGLER_UI_LANGUAGE", saved.c_str()), 0);
+#else
+  EXPECT_EQ(present ? setenv("PLOTJUGGLER_UI_LANGUAGE", saved.c_str(), 1) : unsetenv("PLOTJUGGLER_UI_LANGUAGE"), 0);
+#endif
+  EXPECT_TRUE(result);
+  EXPECT_EQ(data_.progress, original);
+}
