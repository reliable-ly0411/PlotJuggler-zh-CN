+TEST_F(CsvRuntimeLanguage, CanonicalWarningsRetainOrderTypeLineAndRawDetail) {
+  PJ::CSV::CsvParseConfig config;
+  config.time_column_index = 0;
+  const auto result = PJ::CSV::ParseCsvData("time,value,value\n2,20,21\n1,10,11\n0,9\nwrong,3,4\n", config);
+  ASSERT_TRUE(result.success);
+  EXPECT_EQ(result.lines_processed, 2);
+  EXPECT_EQ(result.lines_skipped, 2);
+  ASSERT_EQ(result.warnings.size(), 4U);
+  const std::vector<PJ::CSV::CsvParseWarning::Type> types = {
+      PJ::CSV::CsvParseWarning::DUPLICATE_COLUMN_NAMES, PJ::CSV::CsvParseWarning::NON_MONOTONIC_TIME,
+      PJ::CSV::CsvParseWarning::WRONG_COLUMN_COUNT, PJ::CSV::CsvParseWarning::INVALID_TIMESTAMP};
+  const std::vector<int> lines = {1, 3, 4, 5};
+  const std::vector<std::string> details = {
+      "Duplicate column names detected; suffixes added", "Time is not monotonically increasing",
+      "Expected 3 columns, got 2", "Invalid timestamp: \"wrong\""};
+  for (size_t i = 0; i < types.size(); ++i) {
+    EXPECT_EQ(result.warnings[i].type, types[i]);
+    EXPECT_EQ(result.warnings[i].line_number, lines[i]);
+    EXPECT_EQ(result.warnings[i].detail, details[i]);
+  }
+}
