+TEST_F(CsvRuntimeLanguage, InvalidCombinedTimestampRetainsBothRawValues) {
+  const std::string date = "坏%1\"Invalid combined timestamp\"";
+  const std::string time = "錯%1'Rows Skipped'";
+  const std::string csv = "date,time,value\n2026-01-02,12:00:00,10\n" + csvCell(date) + "," + csvCell(time) + ",20\n";
+  ASSERT_TRUE(import(csv, {{"time_mode", "combined"}, {"combined_date_index", 0}, {"combined_time_index", 1}}));
+  checkSkipped(
+      expected("Line 3: Invalid combined timestamp: ", "行 3: 无效的组合时间戳：", "行 3: 無效的組合時間戳記：") +
+      "\"" + date + "\" + \"" + time + "\"\n");
+  EXPECT_EQ(data_.rows, (std::vector<std::vector<double>>{{10}}));
+  PJ::CSV::CsvParseConfig config;
+  config.combined_columns.push_back({0, 1, "date + time"});
+  config.combined_column_index = 0;
+  const auto parsed = PJ::CSV::ParseCsvData(csv, config);
+  ASSERT_EQ(parsed.warnings.size(), 1U);
+  EXPECT_EQ(parsed.warnings[0].detail, "Invalid combined timestamp: \"" + date + "\" + \"" + time + "\"");
+}
