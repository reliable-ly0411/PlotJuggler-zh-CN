+TEST_F(CsvRuntimeLanguage, ConfigurationAndDynamicPathErrorsRemainCanonical) {
+  auto source = library_.createHandle();
+  ASSERT_TRUE(source.bind(registry_.view()));
+  const auto malformed = source.loadConfig("{");
+  ASSERT_FALSE(malformed);
+  EXPECT_EQ(malformed.error(), "plugin: invalid config JSON");
+  ASSERT_TRUE(source.loadConfig("{}"));
+  const auto absent = source.start();
+  ASSERT_FALSE(absent);
+  EXPECT_EQ(absent.error(), "plugin: no filepath configured");
+  const auto missing = root_ / std::filesystem::path(u8"不存在%1'CSV parsing failed'.csv");
+  ASSERT_TRUE(source.loadConfig(nlohmann::json{{"filepath", utf8(missing)}}.dump()));
+  const auto unreadable = source.start();
+  ASSERT_FALSE(unreadable);
+  EXPECT_EQ(unreadable.error(), "plugin: cannot open file: " + utf8(missing));
+  EXPECT_TRUE(data_.fields.empty());
+  EXPECT_TRUE(data_.rows.empty());
+}
