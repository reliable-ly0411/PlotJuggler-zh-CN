+    vt.abi_version = PJ_PLUGIN_DATA_API_VERSION;
+    vt.struct_size = sizeof(vt);
+    vt.ensure_topic = +[](void*, PJ_string_view_t, PJ_topic_handle_t* out, PJ_error_t*) noexcept {
+      *out = PJ_topic_handle_t{1};
+      return true;
+    };
+    vt.ensure_field = +[](void* ctx, PJ_topic_handle_t topic, PJ_string_view_t name, PJ_primitive_type_t type,
+                          PJ_field_handle_t* out, PJ_error_t*) noexcept {
+      if (type != PJ_PRIMITIVE_TYPE_FLOAT64) {
+        return false;
+      }
+      auto& fields = static_cast<CapturedData*>(ctx)->fields;
+      fields.emplace_back(name.data, name.size);
+      *out = PJ_field_handle_t{topic, static_cast<uint32_t>(fields.size())};
+      return true;
+    };
+    vt.append_record = +[](void*, PJ_topic_handle_t, int64_t, const PJ_named_field_value_t*, uint64_t,
+                           PJ_error_t*) noexcept { return false; };
+    vt.append_bound_record = +[](void* ctx, PJ_topic_handle_t, int64_t timestamp, const PJ_bound_field_value_t* values,
+                                 uint64_t count, PJ_error_t*) noexcept {
+      auto& state = *static_cast<CapturedData*>(ctx);
+      std::vector<double> row(state.fields.size());
+      for (uint64_t i = 0; i < count; ++i) {
+        const auto& value = values[i];
+        if (value.is_null || value.value.type != PJ_PRIMITIVE_TYPE_FLOAT64 || value.field.id == 0 ||
+            value.field.id > row.size()) {
+          return false;
+        }
+        row[value.field.id - 1] = value.value.data.as_float64;
+      }
+      state.timestamps.push_back(timestamp);
+      state.rows.push_back(std::move(row));
+      return true;
+    };
+    vt.append_arrow_stream =
+        +[](void*, PJ_topic_handle_t, ArrowArrayStream*, PJ_string_view_t, PJ_error_t*) noexcept { return false; };
+    return vt;
+  }();
+  return {data, &vtable};
+}
+
+PJ_data_source_runtime_host_t runtimeHost(void* context) {
+  static const auto vtable = [] {
+    PJ_data_source_runtime_host_vtable_t vt{};
+    vt.protocol_version = 1;
+    vt.struct_size = sizeof(vt);
+    vt.report_message = +[](void* ctx, PJ_data_source_message_level_t, PJ_string_view_t value) noexcept {
+      static_cast<CapturedData*>(ctx)->reports.emplace_back(value.data, value.size);
+    };
+    vt.progress_start = +[](void* ctx, PJ_string_view_t value, uint64_t, bool, PJ_error_t*) noexcept {
+      static_cast<CapturedData*>(ctx)->progress.emplace_back(value.data, value.size);
+      return true;
+    };
+    vt.progress_update = +[](void* ctx, uint64_t) noexcept {
+      auto& state = *static_cast<CapturedData*>(ctx);
+      state.stop = state.cancel_on_progress;
+      return !state.stop;
+    };
+    vt.progress_finish = +[](void*) noexcept {};
+    vt.is_stop_requested = +[](void* ctx) noexcept { return static_cast<CapturedData*>(ctx)->stop; };
+    vt.notify_state = +[](void*, PJ_data_source_state_t) noexcept {};
+    vt.request_stop = +[](void*, PJ_data_source_state_t, PJ_string_view_t) noexcept {};
+    vt.show_message_box = +[](void* ctx, PJ_message_box_type_t type, PJ_string_view_t title, PJ_string_view_t body,
+                              int buttons) noexcept -> int {
+      auto& state = *static_cast<CapturedData*>(ctx);
+      state.messages.push_back({type, std::string(title.data, title.size), std::string(body.data, body.size), buttons});
+      return state.answer;
+    };
+    return vt;
+  }();
+  return {context, &vtable};
+}
+
+// Read a test expectation without the production helper or deprecated Windows getenv.
+std::pair<bool, std::string> environmentLanguage() {
+#ifdef _WIN32
+  char* value = nullptr;
+  size_t size = 0;
+  if (_dupenv_s(&value, &size, "PLOTJUGGLER_UI_LANGUAGE") != 0) {
+    return {false, ""};
+  }
+  const bool present = value != nullptr;
+  const std::string result = present ? value : "";
+  std::free(value);
+  return {present, result};
+#else
+  const char* value = std::getenv("PLOTJUGGLER_UI_LANGUAGE");
+  return {value != nullptr, value != nullptr ? value : ""};
+#endif
+}
+
+// Expectations are independent of the production language helper and run in fresh processes.
+std::string expected(const char* english, const char* simplified, const char* traditional) {
+  const auto selected = environmentLanguage().second;
+  return selected == "zh_CN" ? simplified : selected == "zh_TW" ? traditional : english;
+}
+
+// Encode literal quote characters instead of testing malformed CSV quote syntax.
+std::string csvCell(const std::string& value) {
+  std::string cell = "\"";
+  for (const char c : value) {
+    if (c == '"') {
+      cell += '"';
+    }
+    cell += c;
+  }
+  return cell + "\"";
+}
+
+class CsvRuntimeLanguage : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    root_ = std::filesystem::temp_directory_path() /
+            ("pj_csv_runtime_" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+    std::filesystem::create_directories(root_);
+    path_ = root_ / std::filesystem::path(u8"合成測試.csv");
+    const std::string plugin = pluginUnderTest();
+    auto loaded = PJ::DataSourceLibrary::load(std::filesystem::path(std::u8string(plugin.begin(), plugin.end())));
+    ASSERT_TRUE(loaded) << loaded.error();
+    library_ = std::move(*loaded);
+    registry_.registerService<PJ::sdk::SourceWriteHostService>(writeHost(&data_));
+    registry_.registerService<PJ::sdk::DataSourceRuntimeHostService>(runtimeHost(&data_));
+  }
+
+  void TearDown() override {
+    std::error_code error;
+    std::filesystem::remove_all(root_, error);
+  }
+
+  PJ::Status import(const std::string& csv, nlohmann::json options = nlohmann::json::object()) {
+    std::ofstream(path_, std::ios::binary) << csv;
+    auto source = library_.createHandle();
+    auto status = source.bind(registry_.view());
+    if (!status) {
+      return status;
+    }
+    options["filepath"] = utf8(path_);
+    options["delimiter"] = ",";
+    options["detect_delimiter"] = false;
+    if (!options.contains("time_mode")) {
+      options["time_mode"] = "row_number";
+    }
+    status = source.loadConfig(options.dump());
+    if (!status) {
+      return status;
+    }
+    return source.start();
+  }
+
+  void checkSkipped(const std::string& detail) const {
+    ASSERT_EQ(data_.messages.size(), 1U);
+    const auto& message = data_.messages.front();
+    EXPECT_EQ(message.title, expected("Rows Skipped", "跳过行", "略過資料列"));
+    EXPECT_EQ(
+        message.body, expected(
+                          "Some rows have an incorrect number of columns and will be skipped:\n\n",
+                          "部分行的列数不正确，将被跳过：\n\n", "部分資料列的欄數不正確，將被略過：\n\n") +
+                          detail + expected("\nContinue loading?", "\n是否继续加载？", "\n是否繼續載入？"));
+    EXPECT_EQ(message.buttons, PJ_MSG_BTN_CONTINUE | PJ_MSG_BTN_ABORT);
+  }
+
+  std::filesystem::path root_, path_;
+  PJ::DataSourceLibrary library_;
+  CapturedData data_;
+  PJ::ServiceRegistryBuilder registry_;
+};
+
+TEST_F(CsvRuntimeLanguage, MalformedRowContinuePreservesValuesAndTimeAxis) {
+  const auto result = import("time,a,b\n0,10,20\n1,11,21\n2,12\n");
+  ASSERT_TRUE(result) << result.error();
+  checkSkipped(
+      expected("Line 4: Expected 3 columns, got 2\n", "行 4: 预期 3 列，实际 2\n", "行 4: 預期 3 欄，實際 2\n"));
+  EXPECT_EQ(data_.rows, (std::vector<std::vector<double>>{{0, 10, 20}, {1, 11, 21}}));
+  EXPECT_EQ(data_.timestamps, (std::vector<int64_t>{0, 1000000000}));
+  EXPECT_EQ(data_.progress, (std::vector<std::string>{expected("Importing CSV", "正在导入 CSV", "正在匯入 CSV")}));
+  EXPECT_EQ(
+      data_.reports, (std::vector<std::string>{
+                         expected("Imported 2 rows, 1 skipped", "已导入 2 行，跳过 1 行", "已匯入 2 列，略過 1 列")}));
+}
+
+TEST_F(CsvRuntimeLanguage, AbortAndCloseDoNotWriteData) {
+  for (const int answer : {static_cast<int>(PJ_MSG_BTN_ABORT), -1}) {
+    data_ = {};
+    data_.answer = answer;
+    const auto result = import("time,a,b\n0,10,20\n1,11,21\n2,12\n");
+    ASSERT_FALSE(result);
+    EXPECT_EQ(result.error(), "plugin: Loading aborted by user");
+    EXPECT_TRUE(data_.fields.empty());
+    EXPECT_TRUE(data_.rows.empty());
+  }
+}
+
+TEST_F(CsvRuntimeLanguage, NonMonotonicTimeRetainsSortingAndAbortSemantics) {
+  const nlohmann::json options{{"time_mode", "column"}, {"time_column_index", 0}};
+  ASSERT_TRUE(import("time,value\n2,20\n1,10\n", options));
+  ASSERT_EQ(data_.messages.size(), 1U);
+  EXPECT_EQ(data_.messages[0].title, expected("Non-monotonic Timestamps", "时间戳非单调递增", "時間戳記非單調遞增"));
+  EXPECT_EQ(
+      data_.messages[0].body, expected(
+                                  "The time column is not monotonically increasing.\nData will be sorted automatically "
+                                  "after loading.\n\nContinue?",
+                                  "时间列不是单调递增的。\n数据将在加载后自动排序。\n\n是否继续？",
+                                  "時間欄不是單調遞增的。\n資料將在載入後自動排序。\n\n是否繼續？"));
+  EXPECT_EQ(data_.rows, (std::vector<std::vector<double>>{{10}, {20}}));
+  EXPECT_EQ(data_.timestamps, (std::vector<int64_t>{1000000000, 2000000000}));
+  data_ = {};
+  data_.answer = PJ_MSG_BTN_ABORT;
+  EXPECT_FALSE(import("time,value\n2,20\n1,10\n", options));
+  EXPECT_TRUE(data_.rows.empty());
+}
+
+TEST_F(CsvRuntimeLanguage, MixedColumnNameIsNeverTranslatedOrInterpolated) {
+  const std::string name = "混合%1'Rows Skipped' \"Column Expected Line\"";
+  ASSERT_TRUE(import("time," + csvCell(name) + "\n0,10\n1,invalid\n2,12\n"));
+  ASSERT_EQ(data_.messages.size(), 1U);
+  EXPECT_EQ(data_.messages[0].title, expected("Mixed Column Type", "混合列类型", "混合欄位類型"));
+  EXPECT_EQ(
+      data_.messages[0].body, expected("Column '", "列 '", "欄 '") + name +
+                                  expected(
+                                      "' has 1 non-numeric cells that were skipped.", "' 中有 1 个非数值单元格已跳过。",
+                                      "' 中有 1 個非數值儲存格已略過。"));
+  EXPECT_EQ(data_.fields, (std::vector<std::string>{"time", name}));
+  EXPECT_EQ(data_.rows, (std::vector<std::vector<double>>{{0, 10}, {1, 0}, {2, 12}}));
+}
