+TEST_F(CsvRuntimeLanguage, ProgressCancellationKeepsTheSamePartialSamplesWithoutPrompting) {
+  std::string csv = "time,value\n";
+  for (int row = 0; row < 200; ++row) {
+    csv += std::to_string(row) + ",10\n";
+  }
+  data_.cancel_on_progress = true;
+  ASSERT_TRUE(import(csv));
+  EXPECT_EQ(data_.rows.size(), 99U);
+  EXPECT_TRUE(data_.messages.empty());
+  ASSERT_FALSE(data_.timestamps.empty());
+  EXPECT_EQ(data_.timestamps.back(), 98000000000LL);
