versions.env text eol=lf
# This verifier is checked against the source-reviewed SHA-256, including in
# source preflight checkouts that inherit the host's Git line-ending settings.
scripts/windows/verify_native_ci_closure.py text eol=lf
# Shell entry points must execute identically in Git Bash and POSIX shells.
*.sh text eol=lf
*.bat text eol=crlf
# Unified diffs require a space-only context line for an empty source line.
packaging/localization/plugin-patches/*.patch text eol=lf whitespace=-blank-at-eol

# This helper is byte-hashed in the reproducible plugin source lock.
packaging/localization/plugin-patches/pj_display_language.hpp text eol=lf

# Preserve byte-stable provenance and offline fixture inputs on every checkout.
packaging/localization/plugin-patches/source-lock.json text eol=lf
packaging/localization/plugin-patches/display_language_test.cpp text eol=lf
docs/localization/CSV-UTF8-SOURCE-REVIEW-20261026.txt text eol=lf
docs/localization/CSV-UTF8-INTEGRATION-INDEPENDENT-REVIEW-20261026.txt text eol=lf

# Unmodified, byte-hashed Qt IFW catalog includes intentional source-string spaces.
packaging/installer/translations/ifw_zh_CN.ts text eol=lf whitespace=-blank-at-eol
# Sample presets deploy byte for byte (layouts pin each data file's content_sha256).
resources/wasm-presets/** -text
resources/wasm-presets/*/data.* -diff
resources/wasm-presets/**/*.png -diff

# Exact upstream 4.1.0 baseline hashes must survive Windows checkout.
